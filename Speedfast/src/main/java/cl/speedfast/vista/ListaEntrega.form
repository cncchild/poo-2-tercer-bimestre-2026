<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="cl.speedfast.vista.ListaEntrega">
  <grid id="27dc6" binding="panel1" default-binding="true" layout-manager="GridLayoutManager" row-count="5" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="20" left="20" bottom="20" right="20"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="7ebdf" class="javax.swing.JLabel" binding="txtAdministradorEntregas">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="ADMINISTRADOR DE ENTREGAS SPEEDFAST"/>
        </properties>
      </component>
      <component id="61bd1" class="javax.swing.JButton" binding="btnCerrarAministradorEntregas">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="4" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="94" height="34"/>
          </grid>
        </constraints>
        <properties>
          <horizontalTextPosition value="0"/>
          <text value="X"/>
        </properties>
      </component>
      <component id="febf0" class="javax.swing.JButton" binding="btnAgregarEntrega">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="+Agregar"/>
        </properties>
      </component>
      <component id="c3e9f" class="javax.swing.JButton" binding="btnEliminarEntrega">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Eliminar"/>
        </properties>
      </component>
      <component id="cba5" class="javax.swing.JButton" binding="btnEditarEntrega">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Editar"/>
        </properties>
      </component>
      <component id="c5d52" class="javax.swing.JLabel" binding="txtListaEntregas">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Detalle lista de entregas"/>

<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="cl.speedfast.vista.ListaUsuarios">
  <grid id="27dc6" binding="formListaUsuarios" layout-manager="GridLayoutManager" row-count="5" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="20" left="20" bottom="20" right="20"/>
    <constraints>
      <xy x="20" y="20" width="531" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="3daa" class="javax.swing.JLabel" binding="lblTitulo">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="ADMINISTRADOR DE USUARIOS DE SPEEDFAST"/>
        </properties>
      </component>
      <component id="30bd5" class="javax.swing.JButton" binding="btnAgregarUsuario">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <horizontalAlignment value="0"/>
          <text value="+ Agregar"/>
        </properties>
      </component>
      <component id="47c22" class="javax.swing.JButton" binding="btnEliminarUsuario">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Eliminar"/>
        </properties>
      </component>
      <component id="45a41" class="javax.swing.JButton" binding="btnEditarUsuario">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Editar"/>
        </properties>
      </component>
      <component id="2d230" class="javax.swing.JLabel" binding="txtTituloUsuarios">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Lista de usuarios"/>
        </properties>
      </component>
      <component id="f67c8" class="javax.swing.JButton" binding="btnRecargarUsuario">
        <constraints>
          <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Recargar"/>
        </properties>
      </component>
      <component id="9d0cd" class="javax.swing.JButton" binding="btnCerrarListaUsuarios">
        <constraints>
          <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <horizontalAlignment value="0"/>
          <horizontalTextPosition value="4"/>
          <text value="X"/>
        </properties>
      </component>
      <scrollpane id="e4b52" binding="jpTable">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="4" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="a344d" class="javax.swing.JTable" binding="jtableUsuarios">
            <constraints/>
            <properties/>

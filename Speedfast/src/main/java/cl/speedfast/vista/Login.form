<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="cl.speedfast.vista.Login">
  <grid id="27dc6" binding="Login" layout-manager="GridLayoutManager" row-count="9" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="20" left="20" bottom="20" right="20"/>
    <constraints>
      <xy x="20" y="20" width="570" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="f04dd" class="javax.swing.JLabel" binding="txtTitulo">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Inicio de sesión"/>
        </properties>
      </component>
      <component id="82a31" class="javax.swing.JLabel" binding="txtParrafo">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Si tienes una cuenta creada, inicie sesión aqui."/>
        </properties>
      </component>
      <component id="89673" class="javax.swing.JTextField" binding="jNombreDejUsuarioTxt">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <text value="Nombre de usuario"/>
        </properties>
      </component>
      <component id="54bd0" class="javax.swing.JPasswordField" binding="jContraseñaPassword">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <text value="Contraseña"/>
        </properties>
      </component>
      <component id="6c3ee" class="javax.swing.JButton" binding="BtnIniciar">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Iniciar sesión"/>
        </properties>
      </component>
      <component id="b518e" class="javax.swing.JLabel">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Si eres un nuevo usuario,  registrate "/>
        </properties>
      </component>
      <component id="878cb" class="javax.swing.JButton" binding="aquiButton" default-binding="true">
        <constraints>
          <grid row="6" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Aqui"/>
        </properties>
      </component>
      <component id="1585e" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="SPPEDFAST"/>
        </properties>
      </component>
      <component id="4bc46" class="javax.swing.JButton" binding="btnCerrar">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <hideActionText value="false"/>
          <horizontalTextPosition value="0"/>
          <text value="X"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
